PROVIDER_PAY_TO_ADDRESS=Fxvz4gTxj2NMECVDD4XM3d5BGfMSv2mViyh4JFHh6oKk

# x402
# Base Sepolia: eip155:84532
# Solana Devnet: solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_PRICE_USDC=0.005
X402_TOKEN_SYMBOL=USDC
X402_TOKEN_VERSION=2
X402_TOKEN_DECIMALS=6
# Optional. For Solana Devnet USDC, x402's default mint is 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU.
# When set, quotes this token contract/mint directly instead of using x402's default asset for the network.
X402_ASSET_ADDRESS=
X402_FACILITATOR_URL=https://x402.org/facilitator

# Cobo Agentic Wallet
CAW_API_BASE_URL=https://api.example.invalid
CAW_WALLET_ID=replace-with-wallet-id
CAW_AGENT_CREDENTIAL=replace-with-agent-credential
# Optional adapter command that returns {"paymentSignatureHeader":"..."}.
# Required for a real CAW -> x402 paid retry until the CAW CLI exposes this header directly.
CAW_X402_PAYMENT_HEADER_COMMAND=

# Local outputs
SQLITE_PATH=./data/risk-report-demo.sqlite
AUDIT_DIR=./audits
